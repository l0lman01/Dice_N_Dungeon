<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Splash/Splash.uss?fileID=7433441132597879392&amp;guid=057f89b867fe4c5d9155fa4a4dbe4d08&amp;type=3#Splash"/>
    <ui:VisualElement name="splashRoot" class="screen splash">
        <ui:VisualElement name="logo" class="splash__logo splash__logo--hidden">
            <ui:VisualElement name="studioLogo" class="splash__studio-logo"/>
            <ui:Label name="studioName" text="PRESS F STUDIO" class="splash__name"/>
        </ui:VisualElement>
        <ui:Label name="prompt" text="Press F to start" class="splash__prompt splash__prompt--hidden"/>
        <ui:Label name="footnote" text="(paying respects is optional)" class="splash__footnote"/>
    </ui:VisualElement>
</ui:UXML>
