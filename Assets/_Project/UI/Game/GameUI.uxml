<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GameUI.uss" />
    <ui:Template name="SettingsPanel" src="../Settings/SettingsPanel.uxml" />
    <ui:VisualElement name="gameUiRoot" class="screen" picking-mode="Ignore">
        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement class="hud__bottom" picking-mode="Ignore">
                <ui:VisualElement name="facePanel" class="hud__face">
                    <ui:VisualElement name="faceDie" class="hud__die">
                        <ui:Label name="faceValue" text="1" class="hud__die-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud__face-info">
                        <ui:Label name="abilityName" text="No ability" class="hud__ability-name" />
                        <ui:Label name="abilityType" text="Roll to get a face" class="hud__ability-type" />
                        <ui:Label name="abilityDescription" text="" class="hud__ability-description" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="bars" class="hud__bars">
                    <ui:ProgressBar name="healthBar" title="HP" low-value="0" high-value="1" value="1" class="hud__bar hud__bar--health" />
                    <ui:ProgressBar name="rollBar" title="Roll" low-value="0" high-value="1" value="1" class="hud__bar" />
                    <ui:ProgressBar name="abilityBar" title="Ability" low-value="0" high-value="1" value="1" class="hud__bar" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="pauseMenu" class="overlay-host overlay is-hidden">
            <ui:VisualElement class="panel">
                <ui:Label text="Paused" class="panel__title" />
                <ui:Button name="resumeButton" text="Resume" class="menu-button" />
                <ui:Button name="pauseSettingsButton" text="Settings" class="menu-button menu-button--secondary" />
                <ui:Button name="pauseMainMenuButton" text="Main menu" class="menu-button menu-button--secondary" />
                <ui:Button name="pauseQuitButton" text="Quit" class="menu-button menu-button--secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="gameOver" class="overlay-host overlay is-hidden">
            <ui:VisualElement class="panel">
                <ui:Label text="GAME OVER" class="panel__title game-over__title" />
                <ui:Label text="Your die rolled its last face." class="panel__text" />
                <ui:Button name="retryButton" text="Retry" class="menu-button" />
                <ui:Button name="gameOverMainMenuButton" text="Main menu" class="menu-button menu-button--secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Instance template="SettingsPanel" name="settingsPanel" class="overlay-host is-hidden" />
    </ui:VisualElement>
</ui:UXML>
